# LiteLLM Proxy Environment Configuration

# Your Anthropic API Key (required to forward requests to Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REQUIRED: Master API key to protect your LiteLLM proxy endpoint and hide your real Anthropic key.
# Clients connecting to this proxy will use this key (e.g. as ANTHROPIC_API_KEY in Claude Code)
# instead of your real Anthropic key, keeping your real key safe and hidden.
LITELLM_MASTER_KEY=sk-litellm-proxy-secure-key-1234


# LiteLLM Log level (DEBUG, INFO, WARNING, ERROR)
LITELLM_LOG=INFO
