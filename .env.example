# LiteLLM Proxy Environment Configuration

# Your Anthropic API Key (required to forward requests to Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Gemini API Key (required to forward requests to Gemini models)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED: Master API key to protect your LiteLLM proxy endpoint and hide your real Anthropic key.
# Clients connecting to this proxy will use this key (e.g. as ANTHROPIC_API_KEY in Claude Code)
# instead of your real Anthropic key, keeping your real key safe and hidden.
LITELLM_MASTER_KEY=sk-litellm-proxy-secure-key-1234


# LiteLLM Log level (DEBUG, INFO, WARNING, ERROR)
LITELLM_LOG=INFO

# Postgres backend: powers cost tracking, virtual-key/budget management and the /ui dashboard.
# Required because docker-compose.yml now uses the litellm-database image variant.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Provider rate-limit profiles, used by generate-key.py to cap default virtual keys ---
# Fill these in with the RPM/TPM tier limits shown on your provider's console, so a
# generated key can't drive the proxy past what the upstream provider would 429 on anyway.
ANTHROPIC_RPM_LIMIT=50
ANTHROPIC_TPM_LIMIT=100000

GEMINI_RPM_LIMIT=60
GEMINI_TPM_LIMIT=250000

# --- SSL / Nginx reverse-proxy setup (used by init-ssl.sh and docker-compose.yml) ---
# Domain that points at this VPS (A record), email for cert notices, and the VPS public IP.
DOMAIN=your-domain.example.com
EMAIL=you@example.com
PUBLIC_IP=203.0.113.10

# Optional: base URL of the running proxy, used by generate-key.py and sync-opencode-models.py
LITELLM_BASE_URL=http://127.0.0.1:4000
